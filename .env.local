# Paddy O Design Tool — Environment Variables
# Copy this file to .env.local and fill in your keys

# xAI (Grok) — for image generation
# Get from: https://console.x.ai/
XAI_API_KEY=your_xai_key_here

# Anthropic — for plant breakdown & design analysis
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google Maps — for address geocoding + satellite imagery + LiDAR
# Get from: https://console.cloud.google.com/ (enable Maps, Solar, Geocoding APIs)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Runway ML — for video animation of designs
# Get from: https://app.runwayml.com/
RUNWAY_API_KEY=your_runway_key_here

# RAG Server — local Python server (start with: python rag_server.py)
# Leave as-is for local development
RAG_SERVER_URL=http://localhost:8765
